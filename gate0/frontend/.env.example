# Copy to .env.local (never committed) to run the dashboard on this computer against the HOSTED backend (Render).
# Leave both lines out to use the backend on this computer (http://localhost:8000).
# The token stays inside the dev server; the browser never sees it.
GATE0_PROXY_TARGET=https://your-service.onrender.com
GATE0_API_TOKEN=the-same-token-the-backend-uses
