# Copy to .env (never commit .env). Real values stay on the server, not in GitHub.
# Which adapter to use for each port: mock | open_meteo | sarvam
GATE0_WEATHER=open_meteo
GATE0_VOICE=sarvam
GATE0_TELEPHONY=sarvam
GATE0_FARMERS=local
GATE0_LEDGER=local
GATE0_DB=weathercall.db

# Weather API endpoint and provider keys
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=

# Sarvam AI Voice & Voice Agent Telephony Configuration
SARVAM_API_KEY=
SARVAM_AGENT_ID=
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
SARVAM_OUTBOUND_URL=https://apps.sarvam.ai/api/outbounds/v1/outbounds
SARVAM_MODEL=bulbul:v4-flash
SARVAM_SPEAKER_KN=meera
SARVAM_SPEAKER_HI=shubh
SARVAM_SPEAKER_EN=meera
SARVAM_PACE=1.0
SARVAM_SAMPLE_RATE=8000

# Dispatcher & Scheduler settings (ACK-17)
GATE0_DISPATCH_HOUR=9
GATE0_DISPATCH_MINUTE=0
GATE0_TIMEZONE=Asia/Kolkata

# Behaviour: values below are placeholders until confirmed with the client
GATE0_CALL_TIME=07:00
GATE0_MAX_ATTEMPTS=3
GATE0_RETRY_GAP_MINUTES=30
GATE0_ON_WEATHER_MISSING=skip
