# Copy to .env (never commit .env). Real values stay on the server, not in GitHub.
# Which adapter to use for each port: mock | <provider name added later>
GATE0_WEATHER=mock               # open_meteo = real forecast (free, no key), saved in GATE0_DB
GATE0_VOICE=mock                 # sarvam = Sarvam TTS to audio files | sarvam_agent = with Sarvam calling
GATE0_TELEPHONY=mock             # sarvam_agent = real calls via a Sarvam Voice Agent (docs/SARVAM_SETUP.md)
GATE0_FARMERS=local              # sheet = read GATE0_FARMERS_FILE
GATE0_FARMERS_FILE=data/farmers.xlsx   # CSV or Excel; keep it out of git (data/ is ignored)
GATE0_LEDGER=local
GATE0_DB=weathercall.db          # file, so the day's results survive between runs
GATE0_AUDIO_DIR=audio            # generated call audio (git-ignored)

# Provider keys: put real values ONLY in gate0/.env, never in this file (it is committed)
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER=priya             # Hindi script uses feminine verbs; pick a matching voice
SARVAM_SAMPLE_RATE=8000
# Sarvam Voice Agent calling (IDs from the dashboard)
SARVAM_AGENT_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE=
SARVAM_POLL_SECONDS=20
SARVAM_CALL_TIMEOUT_SECONDS=300

# How calls are made: direct = our code dials | campaign = Sarvam Campaigns dial (weathercall.campaign)
GATE0_CALL_MODE=campaign
SARVAM_CALL_WINDOW_END=11:00     # campaign mode: Sarvam stops dialling each day at this time

# Behaviour: values below are placeholders until confirmed with the client
GATE0_CALL_TIME=09:00
GATE0_MAX_ATTEMPTS=2
GATE0_RETRY_GAP_MINUTES=30
GATE0_ON_WEATHER_MISSING=skip

# --- Database ---
# Leave empty to keep using the SQLite file (GATE0_DB). For Supabase, paste the Session pooler connection string here
# (see docs/SUPABASE.md). Never commit this value: it holds the database password.
GATE0_DATABASE_URL=
GATE0_DB_SCHEMA=agrythm

# --- Hosted API (Render). See docs/DEPLOY.md ---
# The API refuses to start on a public address without a token, and every call except /api/health must send it.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GATE0_API_HOST=127.0.0.1
GATE0_API_TOKEN=

# --- Weather (WeatherAPI.com, free key from weatherapi.com) ---
# When set it is the weather source (instead of Open-Meteo). Weather is fetched only when a call is made, once per place and day;
# the free plan gives 3 days, all saved. Never commit the key.
WEATHERAPI_KEY=

# --- Weather (Open-Meteo, used when WEATHERAPI_KEY is empty) ---
# Empty: the free service (non-commercial, and a shared hosting address such as Render's may be throttled with HTTP 429).
# With a paid key from open-meteo.com the backend uses the customer addresses. Never commit the key.
OPEN_METEO_API_KEY=
